/target
**/*.rs.bk
*.pdb

# Build artifacts
Cargo.lock.bak

# Local oracle output (regenerate with scripts/build-oracle.sh)
/target/oracle

# Editor
.idea/
.vscode/
*.swp

# Node
**/node_modules/
**/dist/
**/*.tsbuildinfo

# The installed agent skills
/.agents/

# Deployment secrets
deploy/.env
deploy/.env.*
!deploy/.env.example

# Anything that looks like a credential, in case a tool writes one here.
# The test key fixtures under crates/*/tests/data/ are exempt: they are
# generated test material, and the repository has always carried them.
*.pem
*.key
*.p12
*.pfx
*.keystore
!crates/*/tests/data/*.pem
!crates/*/tests/data/*.key
.env
.env.*
!.env.example
secrets/
credentials/
