# Base URL of the ZT-next controller API.
#
# Leave unset to use the Vite dev-server proxy, which forwards /api/v1 to
# http://127.0.0.1:8080 by default. Point VITE_ZT_CONTROLLER_PROXY elsewhere
# to change that upstream.
#
# Set this when the console is served by a different origin than the
# controller, for example behind a reverse proxy:
#
# VITE_ZT_CONTROLLER_URL=/api/v1

# Set to 1 to run the console against the bundled demo data instead of a
# live controller.
#
# VITE_ZT_USE_FIXTURES=1
