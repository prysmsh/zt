# The ZT-next console deployment.
#
# Copy to .env and fill in the values. The .env file holds no secrets — the
# console authenticates through the OIDC provider, and the controller
# verifies tokens with the provider's public keys.

# The public hostname of the console. Caddy issues a certificate for it and
# the OIDC redirect URI is derived from it.
ZT_PUBLIC_HOST=zt.prysm.sh

# The OIDC provider. The JWKS endpoint is discovered from the issuer when
# ZT_OIDC_JWKS is not set.
ZT_OIDC_ISSUER=https://auth.prysm.sh/oidc
ZT_OIDC_AUDIENCE=zt-console-app-001

# The role that grants access to the master console, and the scope a
# tenant-scoped token must carry.
ZT_OIDC_OPERATOR_ROLE=zt:operator
ZT_OIDC_TENANT_SCOPE=zt:tenant

# The certificate authority's email, for ACME.
ACME_EMAIL=admin@prysm.sh

# The controller's log level.
RUST_LOG=info
