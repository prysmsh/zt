# The ZT-next console.
#
# Four routes are served:
#
#   /              → the landing page
#   /landing/      → the landing page's own files
#   /console/      → the console's static bundle
#   /auth/callback → the OIDC callback, which the console's JavaScript reads
#
# The controller requires a bearer token on every route except the health
# check. The console obtains the token through the authorization code flow
# with PKCE and sends it on every request.
#
# # TLS
#
# The host's ports 80 and 443 are held by the Verity stack, so this Caddy
# listens on 8080 in plain HTTP. Put it behind the existing reverse proxy,
# or terminate TLS here with ZT_TLS_CERT and ZT_TLS_KEY.
#
# When TLS is terminated upstream, the browser's request arrives over HTTP,
# so the console must be told to build its callback URL with https. That is
# the ZT_PUBLIC_SCHEME variable.

{
	admin off
	email {$ACME_EMAIL}
}

# The listen address. The host's ports 80 and 443 are held by the Verity
# stack, so this Caddy speaks plain HTTP and is expected to sit behind a
# reverse proxy that terminates TLS.
#
# The scheme is explicit, so Caddy does not try to obtain a certificate.
# The port is the container's port, which the compose file publishes on the
# host.
#
# The site address is a bare port, so it answers on any hostname. A request
# that arrives with a Host header the site does not name would otherwise
# fall through to a default site block that serves nothing.
:{$ZT_LISTEN_PORT:80} {
	encode zstd gzip

	# The API. The controller is not published, so it is reached over the
	# compose network only.
	handle /api/* {
		reverse_proxy controller:8080
	}

	# The OIDC callback. The console's JavaScript reads the code from the
	# URL, so the response has to be the console's page rather than a
	# redirect that loses the query string.
	handle /auth/callback {
		rewrite * /console/index.html
		reverse_proxy console:80
	}

	# The console, and the assets its bundle asks for.
	handle /console/* {
		reverse_proxy console:80
	}

	handle /landing/* {
		reverse_proxy landing:80
	}

	# The landing page is the front door.
	handle {
		reverse_proxy landing:80
	}

	log {
		output stdout
		format console
	}
}
